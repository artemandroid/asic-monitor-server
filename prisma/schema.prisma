generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Miner {
  id                 String   @id
  ip                 String?
  asicType            String?
  firmware            String?
  authType            String?
  expectedHashrate    Float?
  autoRestartEnabled  Boolean  @default(false)
  postRestartGraceMinutes Int  @default(10)
  lowHashrateThresholdGh Float?
  autoPowerOnGridRestore Boolean @default(false)
  autoPowerOffGridLoss Boolean @default(false)
  boundTuyaDeviceId     String?
  autoPowerOffGenerationBelowKw Float?
  autoPowerOnGenerationAboveKw Float?
  autoPowerOffBatteryBelowPercent Float?
  autoPowerOnBatteryAbovePercent Float?
  autoPowerRestoreDelayMinutes Int @default(10)
  overheatProtectionEnabled Boolean @default(true)
  overheatShutdownTempC Float @default(83)
  overheatSleepMinutes Int @default(30)
  overheatLocked Boolean @default(false)
  overheatLockedAt DateTime?
  overheatLastTempC Float?
  manualPowerHold   Boolean @default(false)
  manualPauseHold   Boolean @default(false)
  // Protective shutdown runtime state (staged: sleep to cool, then cut relay).
  protectiveShutdownAt     DateTime?
  protectiveShutdownReason String?  // OVERHEAT | CRITICAL_BATTERY | GRID_LOSS | BATTERY_THRESHOLD
  protectiveShutdownPhase  String?  // SLEEPING | OFF
  pendingWakeAfterPowerOn  Boolean @default(false)
  // Per-miner overrides for the global protective/pause defaults (null = inherit global).
  overheatActionOverride          String?
  protectiveSleepMinutesOverride  Int?
  pauseReactOverheatOverride          Boolean?
  pauseReactLowHashrateOverride       Boolean?
  pauseReactBatteryDischargeOverride  Boolean?
  lastSeen            DateTime?
  online              Boolean?
  readStatus          String?
  error               String?
  lastMetric          Json?
  lastOnlineAt        DateTime?
  lastRestartAt       DateTime?
  lastLowHashrateAt   DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Command {
  id         String   @id
  minerId    String
  type       String
  status     String
  createdAt  DateTime @default(now())
  executedAt DateTime?
  error      String?
}

model Settings {
  id                       Int      @id @default(1)
  autoRestartEnabled       Boolean  @default(true)
  minerSyncIntervalSec     Int      @default(60)
  deyeSyncIntervalSec      Int      @default(360)
  tuyaSyncIntervalSec      Int      @default(3600)
  restartDelayMinutes      Int      @default(10)
  postRestartGraceMinutes  Int      @default(10)
  lowHashrateThresholdGh   Float    @default(10)
  hashrateDeviationPercent Float    @default(10)
  notifyAutoRestart        Boolean  @default(true)
  notifyRestartPrompt      Boolean  @default(true)
  notificationVisibleCount Int      @default(2)
  criticalBatteryOffPercent Float   @default(30)
  useNetMeteringForGreenTariff Boolean @default(false)
  miningStartDate          DateTime?
  // Global defaults for protective shutdown / pause-exceptions (overridable per miner).
  protectiveSleepMinutes   Int      @default(5)
  overheatAction           String   @default("NAP") // NAP = sleep then auto-wake; SHUTDOWN = sleep then power off
  pauseReactOverheat       Boolean  @default(true)
  pauseReactLowHashrate    Boolean  @default(true)
  pauseReactBatteryDischarge Boolean @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model TuyaSnapshotCache {
  id        Int      @id @default(1)
  snapshot  Json
  fetchedAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DeyeEnergySample {
  id                 Int      @id @default(autoincrement())
  minuteTs           DateTime @unique
  generationPowerKw  Float?
  consumptionPowerKw Float?
  wirePowerKw        Float?
  batteryPowerKw     Float?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  type      String
  message   String
  minerId   String?
  action    String?
  createdAt DateTime @default(now())
}

model ElectricityTariff {
  id            Int      @id @default(autoincrement())
  effectiveFrom DateTime
  dayRateUah    Float
  nightRateUah  Float
  greenRateUah  Float    @default(0)
  createdAt     DateTime @default(now())
}
